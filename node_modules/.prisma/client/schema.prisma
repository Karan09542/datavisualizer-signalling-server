generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  username           String
  passwordHash       String?
  photoData          Bytes?   @db.Blob
  defaultTargetEmail String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
